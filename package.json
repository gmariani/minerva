{
    "name": "minerva",
    "version": "4.4.0",
    "private": true,
    "type": "module",
    "description": "Online shared object editor",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "typecheck": "tsc",
        "check:blazeds": "sh tools/blazeds/run.sh",
        "check:flash": "sh tools/flash/run.sh"
    },
    "keywords": [
        "shared",
        "object",
        "AMF0",
        "AMF3"
    ],
    "author": "Gabriel Mariani",
    "license": "ISC OR MIT OR Apache-2.0",
    "bugs": {
        "url": "https://github.com/gmariani/minerva/issues"
    },
    "homepage": "https://mariani.life/projects/minerva/",
    "browserslist": [
        "> 0.2%",
        "not dead",
        "not op_mini all",
        "last 3 iOS versions"
    ],
    "dependencies": {
        "pako": "^2.1.0",
        "react": "^19.2.9",
        "react-dom": "^19.2.9"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/pako": "^2.0.4",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "8.3.4"
    },
    "overrides": {
        "minimatch": "11.0.2"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
